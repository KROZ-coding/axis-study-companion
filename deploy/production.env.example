# Non-secret production configuration. Install outside the checkout.
# Inject provider keys through a separate, restricted service environment.
SKIP_ENV_FILE=1
APP_ENV=production
APP_NAME=伴星导学 AXIS
DATA_DIR=/var/lib/axis-study-companion
STUDY_DEMO_ENABLED=false
STUDY_WORKER_ENABLED=true
STUDY_WORKER_CONCURRENCY=2
COOKIE_SECURE=true
# Replace with the same real hostname used by the HTTPS reverse proxy.
ALLOWED_HOSTS=study.example.org
CORS_ORIGINS=
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
LLM_REASONING_EFFORT=high
LLM_INTERACTION_TIMEOUT_SECONDS=180
LLM_BATCH_TIMEOUT_SECONDS=360
LLM_INTERACTION_MAX_TOKENS=4096
LLM_BATCH_MAX_TOKENS=8192
# Begin with paid calls disabled. Configure all four explicit groups and agreed
# versioned prices using server/.env.example and the model integration guide.
LLM_PROVIDERS_JSON=
LLM_PRICES_JSON=
BUDGET_CURRENCY=site-credit
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAXKB_URL=
MAXKB_API_KEY=
