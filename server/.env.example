# Local platform. Never commit the real .env or credentials.
APP_ENV=development
APP_NAME=智慧学伴 API
# Relative paths resolve below server/. Formal and demo data must use different roots.
DATA_DIR=./data
STUDY_DEMO_ENABLED=false
STUDY_WORKER_ENABLED=true
STUDY_WORKER_CONCURRENCY=2
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost
# Only for the explicitly separate fictional sample instance.
STUDY_PERSISTENCE_ENABLED=true
STUDY_DATA_DIR=./data/study

# Formal gateway uses only explicit grouped configuration, fixed model IDs and high.
LLM_REASONING_EFFORT=high
LLM_INTERACTION_TIMEOUT_SECONDS=180
LLM_BATCH_TIMEOUT_SECONDS=360
LLM_INTERACTION_MAX_TOKENS=4096
LLM_BATCH_MAX_TOKENS=8192
POKE_TEACHER_API_KEY=
POKE_STUDENT_API_KEY=
# Enable only after configuring authorized credentials and versioned prices.
# LLM_PROVIDERS_JSON=[{"name":"poke-teacher","channel":"teacher","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_TEACHER_API_KEY","model":"gpt-5.6-sol"},{"name":"poke-student","channel":"student","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_STUDENT_API_KEY","model":"gpt-5.6-terra"},{"name":"poke-grading","channel":"grading","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_STUDENT_API_KEY","model":"gpt-5.6-terra"},{"name":"poke-summary","channel":"summary","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_STUDENT_API_KEY","model":"gpt-5.6-terra"}]
LLM_PRICES_JSON=
BUDGET_CURRENCY=site-credit
# Prices are an array of provider,model,version,currency,input_units_per_million,
# output_units_per_million. Enter actual agreed integer prices, never guessed rates.
# Configure project scope_id=platform, teaching scope_id=class_id (or default for free study),
# and student_daily scope_id=user_id using authenticated /api/v1/budgets/limits.
# No configured price/budget means no paid call. Objective grading remains local.

# Legacy adapters retained for the old project; not the formal gateway fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAXKB_URL=
MAXKB_API_KEY=
MAXKB_DATASET_IDS=
KNOWLEDGE_DIR=
KNOWLEDGE_INDEX_PATH=
