# Local sample application only. Never expose this development service publicly.
APP_ENV=development
APP_NAME=智慧学伴 API
STUDY_PERSISTENCE_ENABLED=true
# Empty uses server/data/study; relative paths resolve from server/.
STUDY_DATA_DIR=

# Reserved adapters: no external model or MaxKB route is enabled by the sample UI.
# Public HTTP(S) endpoints only; localhost/private/reserved addresses are rejected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_TOKENS=1200
# Poke API: teacher/question generation/review -> gpt-5.6-sol; student/grading -> gpt-5.6-terra.
# Both use the high reasoning level. Configure channel keys locally; never commit them.
LLM_REASONING_EFFORT=high
POKE_TEACHER_API_KEY=
POKE_STUDENT_API_KEY=
# Enable only after filling both keys. Base URL includes /v1 for this adapter.
# LLM_PROVIDERS_JSON=[{"name":"poke-teacher","channel":"teacher","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_TEACHER_API_KEY","model":"gpt-5.6-sol"},{"name":"poke-student","channel":"student","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_STUDENT_API_KEY","model":"gpt-5.6-terra"},{"name":"poke-grading","channel":"grading","base_url":"https://www.poke2api.com/v1","api_key_env":"POKE_STUDENT_API_KEY","model":"gpt-5.6-terra"}]
MAXKB_URL=
MAXKB_API_KEY=
MAXKB_DATASET_IDS=
KNOWLEDGE_DIR=
KNOWLEDGE_INDEX_PATH=
